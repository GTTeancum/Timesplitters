+// Test-only backend captures submitted Q and the CSR value observed during Present.
+struct Recorder final:GSRasterBackend {
+ GSRegisters* regs=nullptr; std::vector<GSPrimitiveBatch> batches;uint64_t csrDuringPresent=0;unsigned presents=0;
+ void Initialize(uint8_t*,uint32_t)override{} void Reset()override{batches.clear();}
+ void Submit(const GSPrimitiveBatch&b)override{batches.push_back(b);}void LoadClut(const GSTex0Reg&,const GSTexClutReg&)override{}
