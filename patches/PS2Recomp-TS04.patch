+namespace {
+using Bytes=std::vector<uint8_t>;
+void u64(Bytes& b,uint64_t v){const auto n=b.size();b.resize(n+8);std::memcpy(b.data()+n,&v,8);}
+void tag(Bytes& b,unsigned loops,unsigned fmt,unsigned nreg,uint64_t regs){u64(b,uint64_t(loops)|0x8000ull|(uint64_t(fmt)<<58)|(uint64_t(nreg)<<60));u64(b,regs);}
+void ad(Bytes& b,uint64_t value,uint64_t reg){u64(b,value);u64(b,reg);}
+Bytes image(unsigned fmt=2){Bytes b;tag(b,3,fmt,0,0);for(unsigned i=0;i<48;++i)b.push_back(uint8_t(17+3*i));return b;}
+Bytes setup(){Bytes b;tag(b,4,0,1,14);ad(b,(64ull<<32)|(1ull<<48)|(1ull<<56),GS_REG_BITBLTBUF);ad(b,0,GS_REG_TRXPOS);ad(b,16ull|(1ull<<32),GS_REG_TRXREG);ad(b,0,GS_REG_TRXDIR);return b;}
