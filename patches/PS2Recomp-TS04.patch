+}
+void register_ps2_gif_stream_tests(){MiniTest::Case("TSGifStream",[](TestCase&tc){
+ tc.Run("IMAGE transfer survives every byte split including tag and CT24 texel",[](TestCase&t){for(unsigned split=1;split<64;++split){Fixture f;f.feed(setup());auto b=image();f.gs.processGIFPacket(b.data(),split);f.gs.processGIFPacket(b.data()+split,unsigned(b.size())-split);t.IsTrue(f.pixels(),"CT24 transfer failed at split "+std::to_string(split));}});
