+ tc.Run("independent PATH2 packet cannot consume pending PATH3 image",[](TestCase&t){Fixture f;f.feed(setup());auto b=image();f.gs.processGIFPacket(b.data(),23,GifPathId::Path3);Bytes p2;tag(p2,1,0,1,14);ad(p2,1,GS_REG_COLCLAMP);f.feed(p2,GifPathId::Path2);f.gs.processGIFPacket(b.data()+23,41,GifPathId::Path3);t.IsTrue(f.pixels(),"PATH3 resumes without treating PATH2 as image data");t.Equals(f.gs.getDebugSnapshot().colclamp,1ull,"PATH2 write executes");});
