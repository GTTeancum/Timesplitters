# The level is loaded and running (one local player).
wait_u32 0x003ae764 == 1
60 none

# Fire while moving and turning: 8 reads firing, 16 not, alternating turn
# directions, about 1,700 reads.
repeat 24
8  r1+cross 128 0 192 128
16 none 128 0 192 128
8  r1+cross 64 32 128 128
16 none 64 32 128 128
8  r1+cross 128 0 64 128
16 none 128 0 64 128
end

# The pause menu: open, walk down and up, close.
2 start
60 none
2 down
20 none
2 down
20 none
2 up
20 none
2 up
20 none
2 start
60 none

# More firing standing still, turning (impacts and explosions at range).
repeat 12
8  r1 128 128 160 128
16 none 128 128 160 128
end
600 none
